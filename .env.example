SECRET_KEY=
# Create this database in MySQL and grant DB_USER access before starting the app.
# Apply migrations/000_base_tables.sql and migrations/001_research_runs.sql in order.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

FLASK_DEBUG=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Live research. There is NO sample-data mode: without a key the agents report that they cannot research.
# Pick ONE: serpapi / serper / zenserp (web + shopping) | brave / searxng / google_cse (web only; no shopping feed).
# searxng = free, self-hosted, no key: set SEARXNG_URL=http://localhost:8080
SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=
SERPER_API_KEY=
ZENSERP_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
SERPAPI_COUNTRY=in
SERPAPI_LANGUAGE=en

# AI model. Default is Claude. To use a free OpenAI-compatible service instead, set LLM_PROVIDER=openai_compat and:
#   Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
#   Groq   : LLM_BASE_URL=https://api.groq.com/openai/v1                            LLM_MODEL=llama-3.3-70b-versatile
#   Ollama : LLM_BASE_URL=http://localhost:11434/v1  (no key)                       LLM_MODEL=llama3.1
# Free tiers/model names change: check each provider's page.
LLM_PROVIDER=anthropic
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Multilingual understanding, spoken summaries in the user's language, free-form follow-up answers.
AI_REPORT_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# How our crawler identifies itself to websites. Put a real contact URL or e-mail here.
USER_AGENT=ResquoraResearchBot/1.0 (+https://your-site.example/bot)

# Optional place-name lookup for "use my device location" (set empty to disable; manual entry still works).
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse

# mysql (production, syncs across devices) or memory (development only)
PLAYGROUND_STORE=mysql
# Per-account research searches displayed per calendar month
SEARCH_LIMIT_PER_MONTH=250
PAGES_PER_AGENT=4
MAX_AGENTS_PER_RUN=12
RUN_TIMEOUT_SECONDS=480
DEFAULT_CURRENCY=INR

HTTP_TIMEOUT_SECONDS=15
CACHE_TTL_SECONDS=900
